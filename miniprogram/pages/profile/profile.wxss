.ava-row {
  display: flex;
  align-items: center;
  padding-bottom: 28rpx;
  border-bottom: 2rpx solid #e7ddcc;
}

.ava {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fffdf8;
  border: 2rpx solid #e7ddcc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  overflow: hidden;
}

.ava-img {
  width: 100%;
  height: 100%;
}

.ava-tip {
  margin-left: 28rpx;
}

.ava-t {
  font-size: 30rpx;
  font-weight: 600;
}

.acc-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx dashed #e7ddcc;
}

.acc-row .k {
  width: 180rpx;
  color: #938a7c;
  font-size: 27rpx;
}

.acc-row .v {
  flex: 1;
  font-size: 28rpx;
}

.submit {
  margin-top: 32rpx;
}

.logout {
  margin-top: 28rpx;
  color: #c4604a;
  border-color: #c4604a;
}

/* 密保邮箱绑定 */
.code-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 16rpx;
}
.code-row .grow {
  flex: 1;
  min-width: 0;
}
.code-btn {
  flex-shrink: 0;
  padding: 0 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 14rpx;
  background: #f0e9db;
  border: 2rpx solid #e0d5c0;
  color: #4a4136;
  font-size: 24rpx;
  white-space: nowrap;
}
.code-btn.dis {
  opacity: 0.55;
}
.hint {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #4a7c5e;
  line-height: 1.5;
}
.err {
  margin-top: 14rpx;
  color: #c4604a;
  font-size: 26rpx;
}
.second {
  margin-top: 20rpx;
}
